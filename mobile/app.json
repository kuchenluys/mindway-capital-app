{
  "expo": {
    "name": "Mindway Capital",
    "slug": "mindway-capital",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mindwaycapital.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.mindwaycapital.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#fbbf24"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Allow Mindway Capital to use Face ID for secure authentication."
        }
      ]
    ],
    "extra": {
      "API_URL": "http://localhost:5000/api",
      "WEBSOCKET_URL": "http://localhost:5000"
    }
  }
}
